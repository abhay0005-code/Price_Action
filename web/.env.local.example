# Optional. The web UI is served by the FastAPI backend from the same origin as the
# `/ws` feed, so the WebSocket defaults to the current host at runtime - you normally
# don't need to set this. Add it only to override the backend WebSocket location
# (e.g. for local dev: ws://localhost:8000).
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# The backend serves the statically exported UI (web/out) at "/". To point it at a
# custom build directory, set WEB_STATIC_DIR on the server (see server/main.py).

# Optional. Strategy Builder: URL of the running Jesse instance embedded in the
# iframe (default http://localhost:9000). The backend talks to the same instance
# via the JESSE_URL env var (see server/main.py).
NEXT_PUBLIC_JESSE_URL=http://localhost:9000
