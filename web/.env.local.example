# Copy to .env.local for local dev
# WebSocket URL for the live feed (point at the FastAPI backend).
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Server-side env used by the /api/proxy route (the Python backend).
# Set in Next.js runtime environment (not .env.local, which is client-bundled).
# BACKEND_URL=http://127.0.0.1:8000