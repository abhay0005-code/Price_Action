DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
UPSTOX_ACCESS_TOKEN=
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=
# Optional AI LLM judge. Default provider "ollama" (local server). Choose from:
#   ollama | huggingface | openrouter | groq | claude | chatgpt
LLM_PROVIDER=ollama
LLM_MODEL=
# Custom OpenAI-compatible base URL + key (overrides provider defaults).
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT=45
# Provider-specific API keys (set the one for your chosen provider).
HF_API_TOKEN=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FINNHUB_API_KEY=
# Alpaca Market Data API (paper keys work for live US market data).
# Create a paper account at https://alpaca.markets and generate keys at
# https://app.alpaca.markets/paper
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
